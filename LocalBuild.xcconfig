// LocalBuild.xcconfig
// Build configuration for local builds with automatic Apple Development signing and iCloud.
// Applied only by `make local` on top of Release; normal Xcode configurations are unchanged.

// `make local` signs with the user's Apple Development team and automatic provisioning.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = 2L6CD9CNHL
PROVISIONING_PROFILE_SPECIFIER =
LOCAL_APP_BUNDLE_IDENTIFIER = com.ryoyayahagi.VoiceInk
REFINE_XPC_BUNDLE_IDENTIFIER = com.ryoyayahagi.VoiceInk.RefineXPC
LOCAL_CODE_SIGN_ENTITLEMENTS = $(SRCROOT)/VoiceInk/VoiceInk.local.entitlements

// The app target uses this path; the XPC service target does not receive the app's CloudKit entitlements.

// Add LOCAL_BUILD compilation flag so Swift code can use #if LOCAL_BUILD
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) LOCAL_BUILD
